# Csak az e2e-hez (npm run e2e): a Billingo TESZT szervezet API kulcsa (app.billingo.hu/api-key)
BILLINGO_TEST_API_KEY=
# A teszt szervezet adószáma. Az e2e első lépése ellenőrzi, hogy a kulcs ehhez a szervezethez tartozik, különben leáll.
BILLINGO_E2E_TAX_CODE=
# Ide megy a bizonylat e-mailes küldésének tesztje. Nélküle a lefedettség-teszt elbukik.
BILLINGO_E2E_EMAIL=
# Szünet a kérések között ezredmásodpercben, hogy az e2e kíméletes legyen a Billingóval. Alapértelmezés: 1500
BILLINGO_E2E_DELAY_MS=
