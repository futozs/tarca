  "bugs": {
    "url": "https://github.com/futozs/tarca/issues"
  },
  "description": "Independent Billingo API v3 client for TypeScript and Node.js: számla, nyugta, díjbekérő, sztornó, partnerek, termékek, export, fizetési webhookok, MCP. 0 függőség. Független projekt, nem a Billingo terméke.",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "agents",
    "llms.txt"
  ],
  "homepage": "https://tarcajs.hu",
  "keywords": [
    "billingo",
    "billingo-api",
    "billingo v3",
    "billing",
    "dijbekero",
    "e-invoice",
    "hungarian",
    "hungary",
    "invoice",
    "nav",
    "nav-online-szamla",
    "nyugta",
    "receipt",
    "szamla",
    "számla",
    "szamlazas",
    "tarcajs",
    "typescript",
    "billingo-client",
    "billingo-sdk",
    "billingo-npm",
    "billingo-typescript",
    "api-client",
    "sdk",
    "nodejs",
    "invoicing",
    "mcp"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "smoke": "node scripts/smoke.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "node scripts/e2e.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:package": "publint --pack npm && attw --pack . --profile node16",
    "readme": "node readme/art/index.mjs && node readme/build.mjs",
    "readme:check": "node readme/build.mjs --check",
    "ci": "npm run lint && npm run typecheck && npm run readme:check && npm run test:coverage && npm run build && npm run check:package",
    "spec:fetch": "node scripts/fetch-spec.mjs",
    "spec:types": "node scripts/generate-types.mjs",
    "drift": "node scripts/drift.mjs",
    "stats": "node scripts/stats.mjs",
    "sbom": "npm sbom --omit dev --sbom-format cyclonedx",
    "size": "node scripts/size.mjs",
    "commitlint": "node scripts/commitlint.mjs --range origin/main..HEAD",
    "prepublishOnly": "npm run ci",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:ci": "node scripts/release.mjs --ci"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
