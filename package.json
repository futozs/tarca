{
  "name": "tarca",
  "version": "0.0.0",
  "private": true,
  "author": {
    "name": "futozs",
    "url": "https://github.com/futozs",
    "email": "zsombi.futo@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futozs/tarca.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.1",
    "fast-check": "^4.10.2",
    "opentype.js": "^2.0.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bugs": {
    "url": "https://github.com/futozs/tarca/issues"
  },
  "description": "Billingo API v3 kliens TypeScripthez: számla, díjbekérő, nyugta, sztornó, partnerek, termékek, költségek, export. 0 függőség, Node, Bun, Deno és Edge.",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "agents",
    "llms.txt"
  ],
  "homepage": "https://tarcajs.hu",
  "keywords": [
    "billingo",
    "billingo-api",
    "billingo v3",
    "billing",
    "dijbekero",
    "e-invoice",
    "hungarian",
    "hungary",
    "invoice",
    "nav",
    "nav-online-szamla",
    "nyugta",
    "receipt",
    "szamla",
    "számla",
    "szamlazas",
    "tarca",
    "typescript"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "smoke": "node scripts/smoke.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "node scripts/e2e.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:package": "publint --pack npm && attw --pack . --profile node16",
    "readme": "node readme/art/index.mjs && node readme/build.mjs",
    "readme:check": "node readme/build.mjs --check",
    "ci": "npm run lint && npm run typecheck && npm run readme:check && npm run test:coverage && npm run build && npm run check:package",
    "spec:fetch": "node scripts/fetch-spec.mjs",
    "spec:types": "node scripts/generate-types.mjs",
    "drift": "node scripts/drift.mjs",
    "stats": "node scripts/stats.mjs",
    "sbom": "npm sbom --omit dev --sbom-format cyclonedx",
    "size": "node scripts/size.mjs",
    "commitlint": "node scripts/commitlint.mjs --range origin/main..HEAD",
    "prepublishOnly": "npm run ci",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:ci": "node scripts/release.mjs --ci"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
